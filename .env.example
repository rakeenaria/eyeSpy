# ==============================================================================
# eyeSpy - Konfigurasi Lingkungan (Environment Configuration)
# ==============================================================================
# Salin file ini menjadi .env lalu isi dengan API Key Groq Anda:
# Dapatkan API Key gratis di: https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Model Groq yang digunakan (default: qwen/qwen3.8-27b)
# Pilihan model aktif: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b

