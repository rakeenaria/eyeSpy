# ==============================================================================
# eyeSpy — Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env lalu sesuaikan kredensial Anda.

# MySQL / MariaDB (XAMPP default)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eyeSpy

# Groq AI API (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
